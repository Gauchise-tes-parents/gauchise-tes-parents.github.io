# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais versionner .env.

# --- Fournisseur d'IA ---------------------------------------------------------
# Clé API Anthropic (https://console.anthropic.com). Vide = mode démonstration (aucune recherche réelle).
ANTHROPIC_API_KEY=
# Modèle de la phase de recherche (doit prendre en charge les outils web_search et web_fetch).
RESEARCH_MODEL=claude-sonnet-5-5
# Modèle de la phase de stratégie (sans outil). claude-haiku-5-5 réduit fortement le coût.
STRATEGY_MODEL=claude-sonnet-5-5
# Tarifs personnalisés (USD par million de jetons) si vous utilisez un modèle absent de la table intégrée.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# --- Serveur ------------------------------------------------------------------
PORT=3000
# 127.0.0.1 en local ; 0.0.0.0 en conteneur ou derrière un reverse proxy
HOST=127.0.0.1
# 1 uniquement derrière un reverse proxy de confiance (lecture de X-Forwarded-For)
TRUST_PROXY=0

# --- Recherche ----------------------------------------------------------------
MAX_SEARCHES_PER_ANALYSIS=6
MAX_FETCHES_PER_ANALYSIS=3
MAX_SEARCHES_EXPRESS=3
MAX_FETCHES_EXPRESS=1
# Taille maximale d'un document ouvert (jetons, hors PDF)
FETCH_MAX_CONTENT_TOKENS=12000
REQUEST_TIMEOUT_MS=180000
# Durée de réutilisation d'un dossier identique (heures). 0 = pas de cache.
CACHE_TTL_HOURS=12

# --- Contrôle des coûts (USD, consommation mesurée) -----------------------------
# Plafonds financiers réels de l'application. 0 = pas de plafond (déconseillé).
DAILY_BUDGET_USD=3
MONTHLY_BUDGET_USD=30
# Coût maximal présumé d'une recherche / d'une stratégie, vérifié avant chaque appel.
ESTIMATE_RESEARCH_USD=0.35
ESTIMATE_STRATEGY_USD=0.06
# Fichier où le compteur de dépenses est conservé entre deux redémarrages
# USAGE_FILE=./data/usage/budget.json

# --- Limites anti-abus ----------------------------------------------------------
PER_IP_ANALYSIS_LIMIT=5
PER_IP_STRATEGY_LIMIT=20
# Conversation continue (mode connecté) : aucune limite de tours ; seulement des limites techniques.
PER_IP_CONVERSATION_LIMIT=40        # tours par adresse IP et par fenêtre de PER_IP_WINDOW_MINUTES
GLOBAL_CONVERSATION_PER_HOUR=400    # tous visiteurs confondus
ESTIMATE_CONVERSATION_USD=0.02      # estimation prudente d'un tour, pour le contrôle du budget
CONVERSATION_MAX_TOKENS=900
PER_IP_WINDOW_MINUTES=10

# --- Bibliothèque et retours -----------------------------------------------------
# Une fiche plus ancienne que ce nombre de jours est signalée « À actualiser »
LIBRARY_STALE_DAYS=365
# 0 pour ne stocker aucun retour utilisateur
STORE_FEEDBACK=1

# Forcer le mode démonstration même si une clé est présente
FORCE_DEMO=0

# --- Base de connaissances locale (v3) ---
# 1 = une fiche qui correspond fortement, stable ou encore à jour, répond sans recherche web (économise le budget).
KB_DIRECT_ANSWER=1
# Propositions de mise à jour des fiches quand la recherche web diverge (jamais appliquées automatiquement).
STORE_UPDATES=1
# UPDATES_FILE=data/updates/proposals.jsonl

# --- Publication (v4) ---
# Interface hébergée ailleurs (ex. GitHub Pages) : origine https autorisée à appeler l'API de ce serveur.
# CORS_ORIGIN=https://ton-compte.github.io

# --- Veille automatique (v4) — voir PUBLIER.md, section 6 ---
# 1 = le serveur planifie lui-même la veille (hébergement avec disque persistant). Sinon : GitHub Actions.
WATCH_ENABLED=0
# Intervalle entre deux cycles, de 24 à 48 heures.
WATCH_INTERVAL_HOURS=24
# Plafond de dépense par cycle (en plus des plafonds journalier et mensuel).
WATCH_MAX_USD_PER_RUN=1.5
# Catégories surveillées (vide = toutes) : politique_fr,europe,geopolitique,economie,societe,ecologie,histoire,sciences_sociales
WATCH_CATEGORIES=
# 1 = ajoute automatiquement une nouvelle valeur officielle vérifiée à côté de l'ancienne (désactivé par défaut).
WATCH_AUTO_APPLY=0
# Jeton requis pour « Actualiser maintenant » depuis l'application (vide = lancement manuel désactivé).
WATCH_ADMIN_TOKEN=
# Notification en cas d'échec (URL https d'un webhook, facultatif).
WATCH_WEBHOOK_URL=
# Texte affiché dans le tableau de bord quand la planification est externe.
# WATCH_EXTERNAL_SCHEDULE=GitHub Actions, tous les jours à 04:17 UTC
